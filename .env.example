# Copy this file to `.env` and fill in every placeholder marked <...>.
#
# NEVER commit the resulting `.env`. It is listed in `.gitignore`, but treat
# that as a safety net rather than a guarantee — verify with `git status`
# before every commit.
#
# Non-secret settings (regions, ports, feature toggles, model paths) are left
# at working defaults and normally need no change.

# ─── Azure Translator ──────────────────────────────────────────────────
AZURE_TRANSLATOR_KEY=<your-azure-translator-key>
AZURE_TRANSLATOR_REGION=<your-azure-region>
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ─── CORS (dev) ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Google Cloud TTS / STT credentials ────────────────────────────────
# Paths to service-account JSON files. Keep these OUTSIDE version control:
# the `keys/` directory is gitignored. `backend/secret_config.py` also probes
# these default filenames automatically.
GOOGLE_STT_CREDENTIALS=keys/google-stt-service-account.json
GOOGLE_TTS_CREDENTIALS=keys/google-tts-service-account.json

# ─── Google OAuth (Sign-In) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/callback
SESSION_SECRET=<generate-a-long-random-string>
FRONTEND_ORIGIN=http://127.0.0.1:5500

# ─── Admin dashboard ───────────────────────────────────────────────────
# Must be at least 16 characters. Common placeholder values are rejected at
# startup and protected routes will return 503.
ADMIN_ACCESS_TOKEN=<your-admin-token-min-16-chars>

# ─── Contribution-form SMTP (auto-reply emails) ────────────────────────
CONTRIB_AUTOREPLY_ENABLED=false

CONTRIB_SMTP_HOST=<your-smtp-host>
CONTRIB_SMTP_PORT=587
CONTRIB_SMTP_USE_TLS=true

CONTRIB_SMTP_USERNAME=<your-smtp-username>
CONTRIB_SMTP_PASSWORD=<your-smtp-app-password>

CONTRIB_FROM_EMAIL=<your-from-email>
CONTRIB_FROM_NAME=Sign2Text Team

# ─── Supabase (optional cloud persistence) ─────────────────────────────
SUPABASE_ENABLED=false
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Leave the service-role key EMPTY unless you specifically need admin
# persistence. It bypasses row-level security — never expose it to a client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT_SEC=10
SUPABASE_USE_FOR_ADMIN=false

# ─── Skeleton overlay streaming ────────────────────────────────────────
KEYPOINTS_STREAM_ENABLED=true

# ─── ASL gloss-to-English normalization via Ollama ─────────────────────
OLLAMA_ASL_ENABLED=false

# ─── ASL model paths ───────────────────────────────────────────────────
# NOTE: this public repository ships model *metadata* only — architecture,
# hyperparameters, and label maps. No weight files are distributed. See
# MODEL_RESULTS.md for evaluation results and their evidence sources, and
# the "What is and isn't in this repository" section of README.md.
#
# Point these at your own trained checkpoint to run the ASL path.
ASL_PIPELINE=ours
OUR_MODEL_CHECKPOINT=backend/checkpoint/curated600_resume2/curated600_resume2_best.ckpt
OUR_MODEL_CONFIG=backend/checkpoint/curated600_resume2/curated600_resume2.yaml
OUR_MODEL_VOCAB=backend/checkpoint/curated600_resume2/curated600_vocab.json

# ─── Segmentation preset ───────────────────────────────────────────────
# Preset name from the sign-boundary segmentation config. Selects the
# velocity thresholds, cooldown, and cover-after-run behaviour used to cut a
# continuous signing stream into classifiable segments.
OUR_SEG_PRESET=<preset-name>
OUR_SLIDING_MODE=true

# Inference-time synonym folding (e.g. GREET -> HELLO). Recommended on.
OUR_SYNFOLD=true

# When an accepted segment's top-1 confidence falls below this value,
# re-classify both halves asynchronously and accept the split if both beat
# the parent.
OUR_REFINE_CONF=0.10

OUR_BLOCKED_LABELS=

# ─── Confidence threshold for accepting a classified segment ───────────
# Lower to surface more candidates, raise to filter noise.
ASL_CONF_THRESHOLD=0.20

# ─── Live spotter knobs (optional overrides) ───────────────────────────
# Uncomment to override the preset. The live spotter uses the same per-frame
# velocity formula as the offline segmenter, so offline-tuned values transfer
# directly.
# OUR_LIVE_ENTER_THRESH=0.004
# OUR_LIVE_EXIT_THRESH=0.001
# OUR_LIVE_MIN_SEGMENT_FRAMES=10
# OUR_LIVE_MAX_SEGMENT_FRAMES=120
# OUR_LIVE_MAX_GAP_FRAMES=8
# OUR_LIVE_COOLDOWN_FRAMES=8
# OUR_LIVE_SMOOTH_WINDOW=7
# OUR_LIVE_FINGERTIP_MIN_CONF=0.3
# OUR_LIVE_MIN_HAND_KPTS=5
# OUR_LIVE_CHANNEL=D
